# Copy to .env and adjust. .env is gitignored - never commit real credentials.
#
#   cp .env.example .env
#
# Both docker-compose.yml and the Spring Boot app read these values, so the app and the
# containers can never drift apart on credentials.

# --- PostgreSQL ---
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_locally
REDIS_PORT=6379

# --- Kafka ---
# Host-facing listener port (the app connects to localhost:29092).
KAFKA_HOST_PORT=29092
# KRaft needs a stable cluster id. Generate your own with:
#   docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --- Optional tools profile ---
KAFKA_UI_PORT=8081

# --- JWT signing ---
# REQUIRED - the app refuses to start without it. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=generate_your_own_do_not_use_this_value
JWT_ISSUER=order-management-platform
JWT_EXPIRATION=15m

# --- External product service (WireMock stand-in) ---
PRODUCT_SERVICE_PORT=8090
PRODUCT_SERVICE_URL=http://localhost:8090

# --- Seeded staff accounts (development only) ---
# ADMIN and SUPPORT cannot be self-registered: POST /api/auth/register always creates a CUSTOMER.
# Set APP_SEED_ENABLED=true and supply passwords to have them created at startup.
#
# Enabling this while SPRING_PROFILES_ACTIVE=prod fails startup on purpose - seeded accounts are a
# development convenience and must never exist in a deployed environment.
APP_SEED_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=
SEED_SUPPORT_USERNAME=support
SEED_SUPPORT_EMAIL=support@test.local
SEED_SUPPORT_PASSWORD=
