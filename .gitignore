# --- Secrets: never commit these ---
.env
*.pem
*.p12
*.jks

# --- Build output ---
target/
build/
*.class

# --- Logs / crash dumps ---
*.log
hs_err_pid*
replay_pid*

# --- Packaged artifacts ---
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Must come after *.jar - the last matching rule wins. This wrapper uses
# distributionType=only-script so no jar is committed today, but regenerating the wrapper with
# `-Dtype=bin` would produce one, and a silently ignored wrapper jar breaks ./mvnw for everyone
# who clones the repo.
!.mvn/wrapper/maven-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
nbproject/private/

# --- macOS ---
.DS_Store

# --- Misc ---
*.ctxt
.mtj.tmp/
HELP.md
